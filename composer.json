{
    "name": "your-github-username/ledger-php",
    "description": "A DDD finance ledger API in PHP (Slim, Eloquent, PostgreSQL), built as a learning project.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "illuminate/database": "^11.0",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "ci": ["@cs", "@stan", "@test"]
    }
}
